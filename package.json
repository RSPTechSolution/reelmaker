{
  "name": "reelmaker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "doctor": "node scripts/doctor.ts",
    "dev": "node scripts/dev.ts",
    "dev:watch": "node scripts/dev.ts --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
